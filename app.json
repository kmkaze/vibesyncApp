{
  "expo": {
    "name": "VibeSyncApp",
    "slug": "vibesyncapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vibesyncapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibesync.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VibeSyncApp uses the camera to upload photos of your services.",
        "NSLocationWhenInUseUsageDescription": "VibeSyncApp uses your location to show nearby services.",
        "NSMotionUsageDescription": "VibeSyncApp reads motion sensors."
      }
    },
    "android": {
      "package": "com.vibesync.app",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "VibeSyncApp uses the camera to upload service photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VibeSyncApp uses your location to find nearby services."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "VibeSyncApp accesses your photos to upload service images."
        }
      ],
      "expo-font"
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "src/app",
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ebf7e732-93e0-4218-9279-15cd158094b3"
      }
    },
    "owner": "kmilounified"
  }
}
